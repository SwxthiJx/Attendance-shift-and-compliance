# Database Settings
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/attendance_db
# SQLite Fallback: sqlite:///./attendance.db
DATABASE_URL=sqlite:///./attendance.db

# Compliance Engine Parameters
MAX_CONTINUOUS_SHIFT_HOURS=10.0
MAX_CONSECUTIVE_WORKING_DAYS=6

# Deduplication Parameters
DEDUPLICATION_WINDOW_SECONDS=60

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
